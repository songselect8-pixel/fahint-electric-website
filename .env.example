# Public frontend env (safe to expose only after provider access/RLS is configured)
# VITE_* values are bundled into the browser. Do not put server secrets here.

# Optional public HTTPS form endpoint. Leave blank to use the email-app flow.
# Must accept a JSON POST with name, email, company, country, model, quantity,
# message; allow this site's origin via CORS; and return HTTP 2xx with
# JSON {"ok":true} or {"success":true} only after accepting the inquiry.
# Configure recipient verification, spam protection and rate limits at the provider.
# No secret tokens in this URL. Rebuild after changing the deployment value.
VITE_INQUIRY_ENDPOINT=

# Provider runtime env names (set in provider UI or CLI prompts; do not paste values in chat)

# Server-only env names (never paste values in chat; set in .env.local or provider env UI)
